{
  "name": "pain-tracker-ai",
  "main": "ai-worker.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "vars": {
    "AI_ENABLED": "false",
    "GROQ_FREE_TIER_CONFIRMED": "false",
    "ALLOWED_ORIGIN": "https://punkfloid.github.io"
  },
  "ratelimits": [{
    "name": "RATE_LIMITER",
    "namespace_id": "1794916801",
    "simple": {"limit": 10, "period": 60}
  }],
  "observability": {"enabled": false}
}
